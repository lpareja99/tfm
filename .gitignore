# Datasets (Kaggle weather set + Flowity defect set) — re-downloadable
data/

# Azure ML training downloads (~102 GB): checkpoints + logs. Local + external disk.
descargas_azure/

# Pretrained backbone cache — public downloads, see models/README.md
models/

# Inference / evaluation outputs
out_weather/
results/
**/outputx5/
**/work_dirs/
**/vis/
