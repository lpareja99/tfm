# Azure ML / ACR coordinates. Copy to `.env` and fill with your own values.
#   cp .env.example .env   &&   edit .env
# `.env` is gitignored. These feed docker-compose.yml (auto-interpolated),
# the Makefile (via `-include .env`) and bajar_jobs.sh (sourced at startup).
# The Azure job specs under experiments/*/azure/*.yml use ${ACR_REGISTRY} /
# azureml:${AZ_COMPUTE} as fill-in markers — substitute them by hand before
# `az ml job create`, because the Azure ML CLI does not expand env vars in YAML.

ACR_REGISTRY=your-registry.azurecr.io
AZ_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
AZ_RESOURCE_GROUP=your-resource-group
AZ_WORKSPACE=your-workspace
AZ_COMPUTE=your-compute-target
