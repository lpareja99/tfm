FROM pytorch/pytorch:1.13.1-cuda11.6-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends\
    libgl1-mesa-glx \
    libglib2.0-0 \
    git \
    build-essential \
    cmake \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/* 

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir "setuptools<70.0" "cmake>=3.25.0"
RUN pip install --no-cache-dir --only-binary=:all: pyarrow mlflow azureml-mlflow

RUN cmake --version

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --no-cache-dir openmim
RUN mim install "mmengine>=0.7.4" "mmcv==2.1.0" "mmdet>=3.0.0" "mmsegmentation>=1.2.2"
RUN rm -rf /root/.cache/mim

#WORKDIR /app/custom_modules
#RUN git clone https://github.com/OpenGVLab/DCNv4.git

COPY . .

WORKDIR /app/custom_modules/ops_dcnv4

ENV CUDA_HOME=/usr/local/cuda
ENV CPATH=/usr/local/cuda/include
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

RUN echo "import torch\n\
def mock_is_available(): return True\n\
torch.cuda.is_available = mock_is_available" > mock_cuda.py && \
    sed -i '1i import mock_cuda' setup.py

ENV FORCE_CUDA="1"

# Local RTX 4070 = 8.6
# Azure A100 GPU = 8.0
# Azure V100 = 7.0
# Other used ones = 7.5
ENV TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"
ENV MAX_JOBS=4
RUN sh make.sh 

WORKDIR /app


CMD ["bash"]